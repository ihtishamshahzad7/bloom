rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profiles & Users: Only age >= 18 allowed
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
                       request.resource.data.age >= 18 &&
                       request.resource.data.name is string;
      allow update: if isOwner(userId) &&
                       (!('age' in request.resource.data) || request.resource.data.age >= 18);
      allow delete: if isOwner(userId);
    }

    // Social Network Posts (Home Feed)
    match /posts/{postId} {
      // Anyone authenticated can read public posts
      allow read: if isAuthenticated();
      // Only 18+ author can create their post
      allow create: if isAuthenticated() &&
                       request.resource.data.authorId == request.auth.uid &&
                       request.resource.data.textCaption is string;
      // Allow updates for likes, poll votes, and comment count increments
      allow update: if isAuthenticated();
      // Only author can delete
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // Nested Threaded Comments
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if isAuthenticated(); // For liking comments
        allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }

    // Social Notifications Center
    match /notifications/{userId}/items/{notificationId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isAuthenticated();
    }

    // Social Follows / Relationships
    match /followers/{targetUserId}/userFollowers/{followerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == followerId;
    }

    // Trending Hashtags: read by authenticated users, aggregated by Cloud Functions
    match /trending_hashtags/{tagId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server-managed only
    }

    // Presence: User can update their own presence doc
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Stories: 24h TTL (cleaned by Cloud Functions); user can create own; readable by authenticated users
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated(); // For incrementing view count or adding viewer
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Streaks: Server-written only (Cloud Function), read by participants
    match /streaks/{matchId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow write: if false; // Strict server-written enforcement
    }

    // Communities: Public read for authenticated users, members write
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;

      match /posts/{postId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if isAuthenticated(); // For liking
        allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }

    // Private Group Circles: Members only
    match /groups/{groupId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.members);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.members);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.members);
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.admins);

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members);
        allow create: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members);
        allow update, delete: if false;
      }
    }

    // Likes collection
    match /likes/{likeId} {
      allow read: if isAuthenticated() &&
                     (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isAuthenticated() &&
                       request.resource.data.fromUserId == request.auth.uid;
      allow delete: if isAuthenticated() &&
                       resource.data.fromUserId == request.auth.uid;
    }

    // Mutual Matches: participants in the users list can read/write
    match /matches/{matchId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.users);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.users);

      // In-match chat messages (text, media, location, disappearing)
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users);
        allow create: if isAuthenticated() &&
                         request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users);
        allow delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid);
      }
    }

    // Safety Reports: Any authenticated user can submit a report; admin-only read
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }
  }
}
