rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isChatMember(matchId) {
      return isAuthenticated() && exists(/databases/(default)/documents/matches/$(matchId)) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/matches/$(matchId)).data.users;
    }

    function isSafeImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isSafeVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function isSafeAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isWithinSize(maxBytes) {
      return request.resource.size <= maxBytes;
    }

    match /private/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isSafeImage() && isWithinSize(7 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/id/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isSafeImage() && isWithinSize(10 * 1024 * 1024);
    }

    match /stories/{userId}/{storyId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || true);
      allow write: if isOwner(userId)
        && (isSafeImage() || isSafeVideo())
        && isWithinSize(25 * 1024 * 1024)
        && request.resource.metadata.createdAt is number;
      allow delete: if isOwner(userId);
    }

    match /chats/{matchId}/{fileName} {
      allow read: if isChatMember(matchId);
      allow write: if isChatMember(matchId)
        && (
          isSafeImage() || isSafeVideo() || isSafeAudio()
        )
        && isWithinSize(30 * 1024 * 1024);
      allow delete: if isChatMember(matchId);
    }

    match /shared/{uid}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) && isSafeImage() && isWithinSize(6 * 1024 * 1024);
    }
  }
}
